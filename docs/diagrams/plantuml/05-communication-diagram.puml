@startuml Authentication Communication
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

title Authentication Communication (online-first)

package "Flutter Client" {
  [User] as U
  [LoginScreen] as LS
  [AuthRepository] as AR
  [ServerAuthRepository] as SR
  [LocalAuthRepository] as LA
  [ApiClient] as AC
  [AuthWrapper] as AW
  [HomeScreen] as HS
}

package "Backend API" {
  [CustomTokenObtainPairView] as TV
  [RegisterView] as RV
  [MeView] as MV
}

U -down-> LS : 1. enter credentials
LS -down-> AR : 2. login(user, pass)
AR -down-> SR : 3. online-first
SR -down-> AC : 4. POST /api/auth/token/
AC -down-> TV : 5. credentials
TV -up-> SR : 6. JWT {access, refresh} (30m / 7d)
SR -up-> AR : 7. TokenPair
AR -right-> AR : 8. store tokens in secure storage
AR -up-> AW : 9. AuthState.authenticated
AW -down-> HS : 10. rebuild
HS -up-> U : 11. show home

AR ..> LA : offline fallback (no JWT)
LA ..> AW : offline session

@enduml

