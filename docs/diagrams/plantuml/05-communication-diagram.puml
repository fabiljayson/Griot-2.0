@startuml Story Reading Communication
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

title Story Reading Communication

package "Flutter Client" {
  [User] as U
  [StoriesScreen] as SS
  [StoryDetailScreen] as SD
  [StoryProvider] as SP
  [StoryRepository] as SR
  [ApiClient] as AC
  [AuthInterceptor] as AI
  [AppDatabase] as DB
}

package "Backend API" {
  [StoryViewSet] as SV
  [StorySerializer] as SVS
  [Story Model] as Mod
}

U -downn-> SD : 2. navigate(slug)
SD -dow-> SS : 1. select story
SS -down-> SP : 3. fetchStory(slug)
SP -down-> SR : 4. getStory(slug)
SR -down-> AC : 5. GET /api/stories/{slug}/
AC -down-> AI : 6. inject Bearer token
AI -down-> SV : 7. forwarded request
SV -down-> Mod : 8. get_object()
Mod -up-> SV : 9. story data
SV -up-> SVS : 10. serialize
SVS -up-> AI : 11. JSON response
AI -up-> AC : 12. pass response
AC -up-> SR : 13. StoryModel
SR -up-> SP : 14. update state
SP -up-> SD : 15. story data
SD -up-> U : 16. render content

SD -right-> DB : 17. upsert into SQLite mirror

@enduml

