@startuml Media Generation Communication
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

title Media Generation Communication

package "Flutter Client" {
  [User] as U
  [VideoGenerationSheet] as VGS
  [VideoStatusPoller] as VPS
  [VideoApiService] as VAS
  [ApiClient] as AC
}

package "Backend API" {
  [VideoViewSet] as VV
  [VideoGenerationJob] as VJ
}

package "External" {
  [Luma AI API] as Luma
}

U -down-> VGS : 1. enter prompt
VGS -down-> VAS : 2. generateVideo()
VAS -down-> AC : 3. POST /api/media/videos/
AC -down-> VV : 4. request
VV -down-> VJ : 5. create job
VV -down-> Luma : 6. call Luma AI
Luma -up-> VV : 7. job_id
VV -up-> VAS : 8. job created
VAS -up-> VPS : 9. start polling

loop Poll every 10s
  VPS -down-> AC : 10. GET /status/video/{id}/
  AC -down-> VV : 11. request
  VV -up-> VPS : 12. job status
  VPS -up-> VGS : 13. update badge
end

VV -up-> VPS : 14. completed + video_url
VPS -up-> VGS : 15. video ready
VGS -up-> U : 16. show player

@enduml
