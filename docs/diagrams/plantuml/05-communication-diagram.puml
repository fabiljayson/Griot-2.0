@startuml Offline Queue Communication
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

title Offline Queue Communication

package "Flutter Client" {
  [User] as U
  [App Widget] as App
  [OfflineQueueInterceptor] as OQI
  [ConnectivityService] as CS
  [OfflineRequestRepo] as ORepo
  [OfflineSyncManager] as OSM
  [ApiClient] as AC
}

package "Backend API" {
  [Django REST Views] as API
}

U -down-> App : 1. bookmark story
App -down-> OQI : 2. POST bookmark/
OQI -down-> CS : 3. isOnline?
CS -up-> OQI : 4. false
OQI -down-> ORepo : 5. saveRequest()
OQI -up-> App : 6. 202 Queued
App -up-> U : 7. show queued msg

CS -down-> OSM : 8. connectivity restored
OSM -down-> ORepo : 9. getPending()
ORepo -up-> OSM : 10. pending list
OSM -down-> AC : 11. replay POST bookmark/
AC -down-> API : 12. HTTP request
API -up-> OSM : 13. 201 Created
OSM -down-> ORepo : 14. markCompleted()

@enduml

