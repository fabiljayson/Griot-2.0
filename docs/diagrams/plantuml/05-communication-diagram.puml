@startuml QR Scan Communication
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

title QR Scan Communication

package "Flutter Client" {
  [User] as U
  [QRScannerWidget] as QR
  [ArtifactDetailScreen] as AD
  [QrApiService] as QAS
  [ApiClient] as AC
}

package "Backend API" {
  [ArtifactViewSet] as AV
  [Artifact Model] as AM
  [QRCodeScan Model] as QS
}

U -down-> QR : 1. scan QR code
QR -down-> QR : 2. decode slug
QR -down-> QAS : 3. lookupArtifact(slug)
QAS -down-> AC : 4. GET /api/artifacts/lookup/
AC -down-> AV : 5. request
AV -down-> AM : 6. find artifact
AV -right-> QS : 7. record scan
AM -up-> AV : 8. artifact JSON
AV -up-> QAS : 9. artifact JSON
QAS -up-> AD : 10. navigate
AD -up-> U : 11. display info

@enduml

