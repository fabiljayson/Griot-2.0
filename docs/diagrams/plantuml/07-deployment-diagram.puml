@startuml Griot 2.0 — System Deployment Architecture (reconciled 2026-09-23)
!theme plain
skinparam node {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam artifact {
  BackgroundColor #FEFECE
  BorderColor #A80036
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam cloud {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}

title Griot 2.0 — System Deployment Architecture
' Render Blueprint (render.yaml): griot-backend service + managed Postgres 16.
' Flutter web is deployed to Vercel (griot-2-0.vercel.app). No S3/CDN/custom TLS.

' ─── Client Devices ───────────────────────────────────
node "Client Devices" {
  node "Mobile" {
    artifact "📱 iOS Device\n(Flutter App)" as iOS
    artifact "📱 Android Device\n(Flutter App)" as Android
  }
  node "Web" {
    artifact "🌐 Browser\n(Flutter Web on Vercel)" as PWA
  }
}

' ─── Flutter Client Layer ─────────────────────────────
package "Flutter Client Layer" {
  artifact "Flutter UI\n(MaterialApp + AppRouter)" as UI
  artifact "Riverpod\nState Management" as Riverpod
  artifact "Dio HTTP Client\n(auth/retry/offline interceptors)" as Dio
  artifact "SQLite / IndexedDB\n(griot_ai.db mirror + queue)" as SQLite
}

' ─── Network ──────────────────────────────────────────
cloud "Network" {
  artifact "HTTPS" as HTTPS
  artifact "Ngrok Tunnel\n(dev only, real devices)" as Ngrok
}

cloud "Vercel (Flutter Web)" {
  artifact "griot-2-0.vercel.app\n(static build + share links)" as Vercel
}

' ─── Render backend ───────────────────────────────────
node "Render.com" {
  node "griot-backend service" {
    artifact "Gunicorn WSGI\n(migrate + start)" as Gunicorn
    artifact "Django REST Framework\n+ SimpleJWT + Throttling" as Django
    artifact "Apps\nusers · stories · qr_codes\n· gamification · media_app · api · web" as Apps
  }
  database "PostgreSQL 16\n(griot-db, managed)" as Postgres
  artifact "Media Files\n/media/ on Render disk" as MediaFiles
}

' ─── External Services ────────────────────────────────
package "External Services" {
  cloud "🎬 Luma AI\nDream Machine" as LumaAI
  cloud "🔊 Google TTS via gTTS\n(no API key)" as TTSService
  cloud "🐛 Sentry\n(optional, DSN-gated)" as Sentry
  cloud "💬 WhatsApp\n(feedback wa.me link)" as WhatsApp
}

' ─── DevOps & Monitoring ──────────────────────────────
package "DevOps & Monitoring" {
  artifact "Health Endpoints\n/api/health/ · /api/health/ready/\n/api/health/metrics/" as HealthCheck
  artifact "Structured JSON Logging\n(RequestLogMiddleware + JsonFormatter)" as StructLog
  artifact "sync_local_users\n(SQLite → Postgres)" as SyncCmd
}

' ─── Connections ──────────────────────────────────────
iOS --> HTTPS
Android --> HTTPS
PWA --> HTTPS
PWA --> Vercel
Vercel --> HTTPS : API + share links
iOS ..> Ngrok
Android ..> Ngrok

UI --> Riverpod
Riverpod --> Dio
Dio --> SQLite

HTTPS --> Gunicorn
Ngrok --> Gunicorn

Gunicorn --> Django
Django --> Apps
Apps --> Postgres : default alias (prod)
Apps --> MediaFiles
Apps ..> SyncCmd

Django --> LumaAI
Django --> TTSService
Django --> Sentry
UI --> WhatsApp
Apps --> HealthCheck
Apps --> StructLog

@enduml

