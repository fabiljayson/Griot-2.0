@startuml Development vs Production
!theme plain
skinparam node {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam artifact {
  BackgroundColor #FEFECE
  BorderColor #A80036
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

title Development vs Production Environment

package "Development Environment" {
  artifact "Flutter App\n(flutter run)\nAPI_BASE_URL=10.0.2.2:8000" as DevApp
  artifact "Django Dev Server\n(manage.py runserver)" as DevServer
  database "SQLite\n(db.sqlite3)" as DevDB
  artifact "Ngrok (optional)\nreal-device testing" as DevNgrok
  artifact "Media: /media/" as DevMedia

  DevApp --> DevServer
  DevApp ..> DevNgrok
  DevNgrok --> DevServer
  DevServer --> DevDB
  DevServer --> DevMedia
}

package "Production Environment" {
  cloud "Flutter Web on Vercel\n(griot-2-0.vercel.app)" as ProdApp
  artifact "Render griot-backend\nGunicorn + Django" as ProdServer
  database "PostgreSQL 16\n(Render griot-db)" as ProdDB
  cloud "Sentry\n(optional)" as ProdSentry

  ProdApp -->|HTTPS API + CORS| ProdServer
  ProdServer --> ProdDB
  ProdServer --> ProdSentry
}

DevServer ..> ProdDB : sync_local_users (migrate data)

@enduml