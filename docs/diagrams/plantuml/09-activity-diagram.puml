@startuml AI Video Generation Process
!theme plain
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

title AI Video Generation Process

start

:User taps\n"Generate Video";

:Display generation form;

:User enters prompt;

if (Prompt valid?) then (No)
  :Show validation error;
  stop
else (Yes)
endif

:POST /api/media/videos/;

:Create VideoGenerationJob\n(status: pending);

:Call Luma AI API;

if (Job submitted?) then (No)
  :Show error;
  :Update status to failed;
  stop
else (Yes)
endif

:Start polling\nVideoStatusPoller;

repeat

  :GET /api/media/status/video/{jobId}/;

  if (Status = processing?) then (Yes)
    :Update progress badge;
    :Show progress percentage;
    :Wait 10 seconds;
  else (No)
  endif

repeat while (Job in progress)

if (Status = completed?) then (Yes)
  :Video URL available;
  :Display video player;

  :User taps play;
  :Play video;

else (No)
  :Status = failed;
  :Show error message;
  :Allow retry;
endif

stop

@enduml
