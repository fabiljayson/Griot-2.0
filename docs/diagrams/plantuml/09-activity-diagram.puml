@startuml QR Code Scan → Artifact Discovery
!theme plain
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

title QR Code Scan → Artifact Discovery

start

:User opens\nQR Scanner;

:Initialize camera;

:Show scanner overlay;

:User scans\nQR code;

:Decode QR →\nartifact slug;

:GET /api/artifacts/lookup/?slug={slug};

if (Artifact found?) then (No)
  :Show "Artifact not found";
  stop
else (Yes)
endif

:Record QRCodeScan\n(device, IP, GPS);

:Display artifact details\ntitle, image, description;

:Load related stories;

if (Related stories?) then (Yes)
  :Display related stories;

  if (User taps\na story?) then (Yes)
    :Navigate to\nStoryDetailScreen;
  else (No)
  endif
else (No)
  :Show "No related stories";
endif

stop

@enduml

