@startuml Offline Sync Process
!theme plain
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

title Offline Sync Process

start

:Device goes offline;

:ConnectivityService\ndetects offline;

note right
  All non-GET requests
  are now queued
end note

:User performs actions\n(bookmark, like, etc.);

:OfflineQueueInterceptor\nqueues request;

:Store in offline_requests\n(method, path, body);

:Return 202 Queued\nto user;

:User continues\nusing app offline;

:Connectivity restored;

:ConnectivityService\ndetects online;

:OfflineSyncManager\ntriggered;

:Load pending requests\nfrom offline_requests;

if (Pending requests?) then (No)
  :No sync needed;
  stop
else (Yes)
endif

while (More pending requests?)

  :Mark request\nas in_progress;

  :Replay HTTP request\nto server;

  if (Server responds\n2xx?) then (Yes)
    :Mark as completed;
  else (No)
    :Increment retry_count;

    if (Max retries\nreached?) then (Yes)
      :Mark as failed;
      :Log error;
    else (No)
      :Keep as pending\nfor next sync;
    endif
  endif

endwhile

:All requests processed;

:Update UI\n(sync complete);

:Clean up completed\nrequests;

stop

@enduml

