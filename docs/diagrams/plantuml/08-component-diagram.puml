@startuml High-Level System Components
!theme plain
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam package {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam cloud {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}

title Griot 2.0 — High-Level System Components

' ─── Flutter Client Application ───────────────────────
package "Flutter Client Application" {

  package "UI Layer" {
    component "Screens\n(Login, Home, Stories,\nStoryDetail, Library,\nQR Scanner, Gamification,\nAdmin Dashboard)" as Screens
    component "Reusable Widgets\n(StoryCard, BadgeCard,\nQuizPlayer, AudioPlayer,\nVideoPlayer, ShareButton)" as Widgets
  }

  package "State Management" {
    component "Riverpod Providers\n(Auth, Story, Library,\nGamification, Admin,\nAudio, Video, QR)" as Riverpod
  }

  package "Feature Services" {
    component "AuthService\n(Online-first JWT login,\noffline fallback)" as AuthSvc
    component "StoryService\n(CRUD, Search,\nBookmarks, Likes; mirror)" as StorySvc
    component "LibraryService\n(Continue Reading,\nRecently Read) — SQLite" as LibrarySvc
    component "GamificationService\n(Quizzes, Badges) — SQLite" as GamificationSvc
    component "QRService\n(Scanner, Artifact Lookup)" as QRSvc
    component "AudioService\n(TTS Playback,\nOffline Audio)" as AudioSvc
    component "VideoService\n(Generation, Polling,\nPlayback)" as VideoSvc
    component "SharingService\n(Social Share,\nQuote Cards)" as ShareSvc
    component "AdminService\n(Analytics, Users List,\nModeration)" as AdminSvc
    component "ArtifactsService\n(Catalogue browse)" as ArtifactsSvc
    component "DiscoverService\n(Region stories)" as DiscoverSvc
    component "SettingsService\n(WhatsApp feedback)" as SettingsSvc
  }

  package "Core Infrastructure" {
    component "ApiClient\n(Dio + Interceptors)" as APIClient
    component "AuthInterceptor\n(Bearer Token,\nAuto-Refresh)" as AuthInterceptor
    component "OfflineQueueInterceptor\n(Request Queuing)" as OfflineInterceptor
    component "ConnectivityService\n(Online/Offline\nDetection)" as ConnectivitySvc
    component "OfflineSyncManager\n(Background Sync)" as OfflineSync
    component "AppDatabase\n(SQLite / IndexedDB)" as LocalDB
    component "Cache Repositories\n(Story, ReadingProgress,\nSearchHistory, Offline)" as CacheRepos
  }
}

' ─── Django REST Framework API ────────────────────────
package "Django REST Framework API" {

  package "Authentication" {
    component "SimpleJWT\n(Token Obtain,\nRefresh, Blacklist)" as JWTAuth
    component "Role-Based Permissions\n(IsContributorOrAbove,\nIsAdminOrManager)" as RolePerms
    component "Rate Throttling\n(auth: 5/min ·\nanon: 120/min · user: 600/min)" as Throttling
  }

  package "Business Logic" {
    component "User Management\n(Register, Profile,\nDelete Account)" as UserMgmt
    component "Story Engine\n(CRUD, Search,\nCategories, Feeds)" as StoryEngine
    component "Content Moderation\n(Flag, Review,\nResolve)" as ContentMod
    component "QR Code Module\n(Artifacts, QR Gen,\nScan Tracking)" as QRModule
    component "Gamification Engine\n(Quizzes, Badges,\nXP, Certificates)" as GameEngine
    component "Media Engine\n(AI Video, TTS)" as MediaEngine
    component "Analytics Engine\n(Dashboard, Metrics,\nEngagement)" as AnalyticsEngine
  }

  package "Infrastructure" {
    component "Health Probes\n(Liveness, Readiness,\nMetrics)" as HealthCheck
    component "Structured Logging\n(JSON Formatter,\nRequest Middleware)" as StructLog
    component "Seed Commands\n(Users, Stories, QR,\nGamification)" as SeedCmds
  }
}

' ─── External Services ────────────────────────────────
package "External Services" {
  cloud "🎬 Luma AI\nDream Machine\n(Video Generation)" as LumaAI
  cloud "🔊 Google TTS via gTTS\n(no API key)" as TTSProvider
  cloud "🐛 Sentry\n(DSN-gated)" as SentryMonitor
  cloud "💬 WhatsApp\n(feedback wa.me link)" as WhatsApp
}

' ─── Data Layer ───────────────────────────────────────
package "Data Layer" {
  database "SQLite\n(db.sqlite3 — dev / local)" as SQLite
  database "PostgreSQL 16\n(Render griot-db — prod)" as PostgreSQL
  artifact "Crawler (ingestion)\ndiscover-cameroon.com →\ncameroon_content.json → import_crawl_data" as Crawler
  artifact "Media\n(Django /media/ on\nRender disk / local)" as MediaStorage
}

' ─── Client Internal Connections ──────────────────────
Screens --> Widgets
Screens --> Riverpod
Widgets --> Riverpod
Riverpod --> AuthSvc
Riverpod --> StorySvc
Riverpod --> LibrarySvc
Riverpod --> GamificationSvc
Riverpod --> QRSvc
Riverpod --> AudioSvc
Riverpod --> VideoSvc
Riverpod --> ShareSvc
Riverpod --> AdminSvc
Riverpod --> ArtifactsSvc
Riverpod --> DiscoverSvc
Riverpod --> SettingsSvc

AuthSvc --> APIClient
StorySvc --> APIClient
LibrarySvc --> LocalDB
GamificationSvc --> LocalDB
QRSvc --> APIClient
AudioSvc --> APIClient
VideoSvc --> APIClient
ShareSvc --> APIClient
AdminSvc --> APIClient
ArtifactsSvc --> APIClient
DiscoverSvc --> APIClient
SettingsSvc --> WhatsApp

APIClient --> AuthInterceptor
APIClient --> OfflineInterceptor
AuthInterceptor --> APIClient
OfflineInterceptor --> ConnectivitySvc
ConnectivitySvc --> OfflineSync
OfflineSync --> APIClient
APIClient --> LocalDB
LocalDB --> CacheRepos

' ─── Client to Server ─────────────────────────────────
APIClient -right-> JWTAuth : HTTPS/JSON

' ─── Server Internal Connections ──────────────────────
JWTAuth --> RolePerms
JWTAuth --> Throttling

UserMgmt --> JWTAuth
StoryEngine --> RolePerms
ContentMod --> RolePerms
QRModule --> RolePerms
GameEngine --> RolePerms
MediaEngine --> RolePerms
AnalyticsEngine --> RolePerms

StoryEngine --> SQLite
QRModule --> SQLite
GameEngine --> SQLite
MediaEngine --> SQLite
AnalyticsEngine --> SQLite
QRModule --> Crawler : import_crawl_data

StoryEngine --> MediaStorage
QRModule --> MediaStorage
Crawler --> MediaStorage

' ─── External Services ────────────────────────────────
MediaEngine --> LumaAI
MediaEngine --> TTSProvider
APIClient -right-> SentryMonitor : client-side
AnalyticsEngine --> SentryMonitor

@enduml
