@startuml Griot 2.0 — Use Case Diagram
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam package {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

title Griot 2.0 — Use Case Diagram

left to right direction

' ─── Actors ────────────────────────────────────────────
actor "Guest" as Guest
actor "Visitor" as Visitor
actor "Contributor" as Contributor
actor "Institution Manager" as InstitutionManager
actor "Admin" as Admin

' ─── Actor Relationships (Inheritance) ─────────────────
Visitor --|> Guest
Contributor --|> Visitor
InstitutionManager --|> Contributor
Admin --|> InstitutionManager

' ─── Authentication Package ────────────────────────────
package "Authentication" {
  usecase "Register Account" as UC_REG
  usecase "Login" as UC_LOGIN
  usecase "View Profile" as UC_PROFILE
  usecase "Delete Account" as UC_DEL_ACC
}

' ─── Stories Package ───────────────────────────────────
package "Stories" {
  usecase "Browse Stories" as UC_BROWSE
  usecase "Search Stories" as UC_SEARCH
  usecase "Read Story" as UC_READ
  usecase "Create Story" as UC_CREATE_STORY
  usecase "Edit Story" as UC_EDIT_STORY
  usecase "Delete Story" as UC_DEL_STORY
  usecase "Bookmark Story" as UC_BOOKMARK
  usecase "Like Story" as UC_LIKE
  usecase "Flag Story" as UC_FLAG
  usecase "Track Reading Progress" as UC_PROGRESS
  usecase "View Curated Feeds" as UC_FEEDS
  usecase "View Trending" as UC_TRENDING
  usecase "View Popular" as UC_POPULAR
  usecase "View Discover" as UC_DISCOVER
}

' ─── Library Package ───────────────────────────────────
package "Library" {
  usecase "View Library" as UC_LIB
  usecase "Continue Reading" as UC_CONTINUE
  usecase "View Bookmarks" as UC_VIEW_BM
  usecase "View Recently Read" as UC_RECENT
}

' ─── QR & Artifacts Package ────────────────────────────
package "QR & Artifacts" {
  usecase "Scan QR Code" as UC_SCAN
  usecase "View Artifact" as UC_ARTIFACT
  usecase "Create Artifact" as UC_CREATE_ART
  usecase "Generate QR Code" as UC_GEN_QR
}

' ─── Audio Package ─────────────────────────────────────
package "Audio" {
  usecase "Listen to TTS" as UC_TTS
  usecase "Generate Audio Narration" as UC_GEN_TTS
  usecase "Play Offline Audio" as UC_OFFLINE_AUDIO
}

' ─── Video Package ─────────────────────────────────────
package "Video" {
  usecase "Generate AI Video" as UC_GEN_VIDEO
  usecase "Watch Video" as UC_WATCH
  usecase "Poll Video Status" as UC_POLL_VIDEO
}

' ─── Gamification Package ──────────────────────────────
package "Gamification" {
  usecase "Take Quiz" as UC_QUIZ
  usecase "View Badges" as UC_BADGES
  usecase "View Leaderboard" as UC_LEADER
  usecase "View Certificate" as UC_CERT
  usecase "View Gamification Profile" as UC_GAME_PROFILE
}

' ─── Sharing Package ───────────────────────────────────
package "Sharing" {
  usecase "Share Story" as UC_SHARE
  usecase "View Quote Card" as UC_QUOTE
}

' ─── Settings Package ──────────────────────────────────
package "Settings" {
  usecase "Send Feedback (WhatsApp)" as UC_FEEDBACK
}

' ─── Admin Package ─────────────────────────────────────
package "Admin" {
  usecase "View Analytics Dashboard" as UC_ANALYTICS
  usecase "View Platform Users" as UC_PLATFORM_USERS
  usecase "Moderate Content" as UC_MODERATE
  usecase "View Moderation Queue" as UC_MOD_QUEUE
  usecase "Resolve Flags" as UC_RESOLVE
}

' ─── Offline Package ───────────────────────────────────
package "Offline" {
  usecase "Save Story Offline" as UC_SAVE_OFFLINE
  usecase "Read Offline" as UC_READ_OFFLINE
  usecase "Sync Pending Requests" as UC_SYNC
}

' ─── Guest Associations (unauthenticated) ──────────────
' Verified: trending/popular/discover and badges are AllowAny in the API.
' NOT listed: UC_VIEW_BM (bookmarks are per-user) and UC_GEN_QR (a
' Manager/Admin action, now enforced as one).
Guest --> UC_REG
Guest --> UC_LOGIN
Guest --> UC_BROWSE
Guest --> UC_SEARCH
Guest --> UC_READ
Guest --> UC_SCAN
Guest --> UC_ARTIFACT
Guest --> UC_TTS
Guest --> UC_WATCH
Guest --> UC_BADGES
Guest --> UC_LEADER
Guest --> UC_TRENDING
Guest --> UC_POPULAR
Guest --> UC_DISCOVER

' ─── Visitor Associations ──────────────────────────────
Visitor --> UC_PROFILE
Visitor --> UC_GEN_TTS
Visitor --> UC_BOOKMARK
Visitor --> UC_LIKE
Visitor --> UC_FLAG
Visitor --> UC_PROGRESS
Visitor --> UC_LIB
Visitor --> UC_CONTINUE
Visitor --> UC_VIEW_BM
Visitor --> UC_RECENT
Visitor --> UC_QUIZ
Visitor --> UC_BADGES
Visitor --> UC_LEADER
Visitor --> UC_CERT
Visitor --> UC_GAME_PROFILE
Visitor --> UC_SHARE
Visitor --> UC_QUOTE
Visitor --> UC_SAVE_OFFLINE
Visitor --> UC_READ_OFFLINE
Visitor --> UC_OFFLINE_AUDIO
Visitor --> UC_FEEDBACK
Visitor --> UC_DEL_ACC

' ─── Contributor Associations ──────────────────────────
Contributor --> UC_CREATE_STORY
Contributor --> UC_EDIT_STORY
Contributor --> UC_DEL_STORY
Contributor --> UC_GEN_TTS
Contributor --> UC_GEN_VIDEO
Contributor --> UC_POLL_VIDEO

' ─── Institution Manager Associations ──────────────────
InstitutionManager --> UC_CREATE_ART
InstitutionManager --> UC_GEN_QR
InstitutionManager --> UC_MODERATE
InstitutionManager --> UC_MOD_QUEUE
InstitutionManager --> UC_RESOLVE
InstitutionManager --> UC_ANALYTICS
InstitutionManager --> UC_PLATFORM_USERS

' ─── Admin Associations ────────────────────────────────
Admin --> UC_DEL_STORY
Admin --> UC_ANALYTICS
Admin --> UC_PLATFORM_USERS
Admin --> UC_DEL_ACC

' ─── Divergences from original intent (reconciled 2026-09-22, +2026-09-23) ──
' Delete Story        : the author may delete their own; Manager/Admin any.
' Generate TTS        : any authenticated user for a PUBLISHED story.
' Browse Quizzes /
' View Leaderboard    : public (IsAuthenticatedOrReadOnly / AllowAny).
' Share Story         : authenticated on both clients, though documented "All".
' View Analytics      : implemented gate is IsAdminOrManager (wider than Admin).
' Generate QR Code    : FIXED 2026-09-22 — previously fell through to AllowAny,
'                       letting an anonymous POST persist qr_code_svg.
' OPEN  co_authors     : declared on Story but read by no authorization check.
' GAP   Guest actor    : AuthWrapper requires auth, so no guest mode in Flutter.
' GAP   publication    : pending -> published happens only in the Django admin.
' GAP   mobile         : no leaderboard, certificate, artifact-authoring,
'                       artifact audio-guide or video-playback UI.
' ADDED 2026-09-23     : UC_FEEDBACK (WhatsAppFeedbackService, wa.me chat,
'                       no backend endpoint) and UC_PLATFORM_USERS
'                       (AdminUsersListView, GET /api/analytics/users/list/).

note bottom of Guest
  Guest is reachable on web + API only —
  the Flutter app has no guest mode.
end note

@enduml
