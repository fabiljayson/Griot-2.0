# ---------------------------------------------------------------------------
# Griot 2.0 monorepo .gitignore
# ---------------------------------------------------------------------------

# --- Python / Django ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.sqlite3
db.sqlite3
db.sqlite3-journal
staticfiles/
.env
.venv/
venv/
env/
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Flutter / Dart -------------------------------------------------------
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
*.g.dart

# --- Node (PWA / web tooling) ---------------------------------------------
node_modules/
.pnpm-store/

# --- Secrets ---------------------------------------------------------------
# Never commit API keys, tokens, or credentials.
API keys.*

# --- Misc -----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
/tmp/

.vercel
.env*

# Media referenced by production data — keep the Render build self-contained
# (free tier has no persistent disk, so these are baked into the image).
# Only the story cover JPGs are un-ignored; everything else under
# backend/media/ (artefacts, audio, qr_codes) stays out of the repo.
backend/media/*
!backend/media/stories/
backend/media/stories/*
!backend/media/stories/covers/
backend/media/stories/covers/*
!backend/media/stories/covers/*.jpg
