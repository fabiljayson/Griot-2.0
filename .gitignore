# ---------------------------------------------------------------------------
# Griot 2.0 monorepo .gitignore
# ---------------------------------------------------------------------------

# --- Python / Django ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.sqlite3
db.sqlite3
db.sqlite3-journal
# Timestamped database backups. `*.sqlite3` does not match
# `db.sqlite3.bak-20261002-180422`, which is how a copy of the dev database
# — 523 user rows and their password hashes — ended up in the history.
*.sqlite3.bak*
*.sqlite3-*
staticfiles/
.env
.venv/
venv/
env/
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Flutter / Dart -------------------------------------------------------
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
*.g.dart

# --- Node (PWA / web tooling) ---------------------------------------------
node_modules/
.pnpm-store/

# --- Secrets ---------------------------------------------------------------
# Never commit API keys, tokens, or credentials.
API keys.*

# --- Misc -----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
/tmp/

.vercel
.env*

# Media referenced by production data — keep the Render build self-contained
# (free tier has no persistent disk, so these are baked into the image).
# Story cover JPGs and artifact images are un-ignored because the seeded
# production data references them; everything else under backend/media/
# (audio, qr_codes) stays out of the repo.
backend/media/*
!backend/media/stories/
backend/media/stories/*
!backend/media/stories/covers/
backend/media/stories/covers/*
!backend/media/stories/covers/*.jpg
!backend/media/artifacts/
backend/media/artifacts/*
!backend/media/artifacts/images/
backend/media/artifacts/images/*
!backend/media/artifacts/images/*.jpg

# Crawler output (regenerable via crawler/main.py) — keep out of git
/downloads/
/plantuml.jar
/Griot_2.0/

# Local zip of the Unity project. 505 MB, and vr/ is already tracked.
/vr.zip
