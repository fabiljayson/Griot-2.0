--- !u!114 &400005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 400000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e41996f7cde74f3e80969583bf7ec0d4, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  slot: {fileID: 412001}
  clothMaterial: {fileID: 2100000, guid: 87624a91607e4994c2e52fd2a8b86949, type: 2}
  frameMaterial: {fileID: 2100000, guid: 8df89d64096dface115d963dd9de92b6, type: 2}
  artifactData:
    artifactId: ndop-textile
    title: Ndop Textile
    description: 'Ndop is an indigo-dyed prestige cloth of the Bamileke and Bamoun
      peoples of Cameroon''s Grassfields, long associated with royalty. White geometric
      motifs are formed by resist-stitching raffia fibre into the cloth before it
      is dipped in indigo.'
    historicalSignificance: 'Artisans sew patterns of raffia fibre into cotton cloth
      as a resist, then dye it in indigo vats; the stitched areas keep the cloth''s
      pale motif against the deep blue. Ndop is worn by chiefs, princes and dignitaries,
      and marks royal ritual space across the Grassfields. Since 2020 it has been
      classified as Cameroonian national heritage by the Ministry of Arts and Culture.'
    culture: Bamileke and Bamoun peoples
    region: Grassfields, Northwest and West Regions, Cameroon
    materials: Cotton cloth, raffia fibre, indigo
    sourceLabel: 'Mingei International Museum — Blue Gold catalogue'
    sourceUrl: 'https://publications.mingei.org/blue-gold/catalogue/17'
