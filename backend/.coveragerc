# Coverage configuration.
#
# The floor was measured before it was set, per docs/ROADMAP.md Phase 2:
#   84% on 4969 statements, with migrations and test modules excluded.
# `heritage_crawl` was added later (it was missing from this list, so the
# crawler -- the largest and most delicate app -- was outside the gate entirely
# while still reporting a green total). Re-measured with it included:
#   84% on 6866 statements, so the 80% floor still holds with room to spare.
#
# `vr` and `griot_ai` are listed for that same reason, not by reflex: a new app
# that is absent here contributes nothing to the total, so its tests are
# optional and its coverage is zero while the gate still reports green. The
# launch-token path is the security boundary of the VR feature; leaving it
# unmeasured would be the same mistake twice.
#
# `fail_under` sits 4 points below the measured number rather than at it. A
# threshold the repo passes by a hair breaks on the first unrelated refactor,
# and a gate that is often red is a gate people learn to ignore. Ratchet it
# upward once — after each phase that adds tests — never downward.
#
# Migrations are excluded because they are execution records, not authored
# logic: covering them measures import order, not behaviour. Test modules are
# excluded for the obvious reason.
[run]
source =
    users
    stories
    qr_codes
    gamification
    notifications
    media_app
    api
    web
    heritage_crawl
    vr
    griot_ai
omit =
    */migrations/*
    */tests.py
    */tests_*.py
    */test_*.py
    *tests*

[report]
fail_under = 80
show_missing = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
