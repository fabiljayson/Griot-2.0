# ---------------------------------------------------------------------------
# Griot 2.0 — Django backend environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,africanteller.org

# Production database (config.settings.prod). Leave empty to fall back to SQLite.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Optional prod overrides
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=true

# Shared cache (strongly recommended in production). Rate limits (DRF
# throttles + the web rate_limit decorator) and the SimpleJWT refresh-token
# blacklist are both cache-backed. Without REDIS_URL they fall back to a
# per-process LocMemCache, which is only exact on a single gunicorn worker:
# `--workers N` multiplies every rate limit by N, and a blacklisted refresh
# token stays valid on any worker that missed the write.
# REDIS_URL=redis://:password@host:6379/0

# Proxies whose X-Forwarded-For is believed. Empty by default, which is
# correct behind Render (the platform proxy address is not client-controlled).
# Only set this to the addresses of proxies you actually operate.
# DJANGO_TRUSTED_PROXY_IPS=

# CORS (production web client origins, comma-separated)
DJANGO_CORS_ORIGINS=https://africanteller.org

# Site URL (used by QR codes, deep links, and share URLs)
SITE_URL=https://africanteller.org
DEEP_LINK_BASE_URL=https://africanteller.org

# Sentry (Phase 10) — https://sentry.io
SENTRY_DSN=

# Firebase Cloud Messaging (Phase 4) — service account JSON path
FIREBASE_CREDENTIALS_PATH=

# --- Video providers -------------------------------------------------------
# The chain tries providers in VIDEO_PROVIDER_ORDER and falls through when one
# is out of credits, unreachable or unconfigured. Set at least one key.

# Luma Agents API (Ray 3.2) — https://agents.lumalabs.ai
# Note: the old api.lumalabs.ai/dream-machine endpoint is retired; a key that
# looks valid there will 403 against every token.
LUMA_API_KEY=
# LUMA_AGENTS_MODEL=ray-3.2
# LUMA_VIDEO_RESOLUTION=720p

# fal.ai — backup provider, `Authorization: Key <FAL_API_KEY>` (not Bearer).
FAL_API_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video

# Order to try them in (default "luma,fal"); unknown names are ignored.
# VIDEO_PROVIDER_ORDER=luma,fal

# Set to 0 to fail loudly when every provider is out instead of serving the
# mock, whose renders report 'completed' against an unplayable placeholder.
# VIDEO_ALLOW_MOCK_FALLBACK=1

# --- Subscriptions ----------------------------------------------------------
# Shared secret for the RevenueCat webhook. Empty = the webhook endpoint
# refuses every request (store sync off until you set one).
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# Development checkout (POST /api/subscriptions/checkout/) grants a period
# without a payment provider. Default OFF. config.settings.dev/.test enable
# it; production must leave it off (set =0 explicitly if unsure).
SUBSCRIPTION_DEV_CHECKOUT=0
