# ---------------------------------------------------------------------------
# Griot 2.0 — Django backend environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,africanteller.org

# CORS (production web client origins, comma-separated)
DJANGO_CORS_ORIGINS=https://africanteller.org

# Sentry (Phase 10) — https://sentry.io
SENTRY_DSN=

# Firebase Cloud Messaging (Phase 4) — service account JSON path
FIREBASE_CREDENTIALS_PATH=

# Luma AI Dream Machine API (Phase 4)
LUMA_API_KEY=
