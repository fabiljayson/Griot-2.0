# ---------------------------------------------------------------------------
# Griot 2.0 — Django backend environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,africanteller.org

# Production database (config.settings.prod). Leave empty to fall back to SQLite.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Optional prod overrides
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=true

# Shared cache (strongly recommended in production). Rate limits (DRF
# throttles + the web rate_limit decorator) and the SimpleJWT refresh-token
# blacklist are both cache-backed. Without REDIS_URL they fall back to a
# per-process LocMemCache, which is only exact on a single gunicorn worker:
# `--workers N` multiplies every rate limit by N, and a blacklisted refresh
# token stays valid on any worker that missed the write.
# REDIS_URL=redis://:password@host:6379/0

# Proxies whose X-Forwarded-For is believed. Empty by default, which is
# correct behind Render (the platform proxy address is not client-controlled).
# Only set this to the addresses of proxies you actually operate.
# DJANGO_TRUSTED_PROXY_IPS=

# CORS (production web client origins, comma-separated)
DJANGO_CORS_ORIGINS=https://africanteller.org

# Site URL (used by QR codes, deep links, and share URLs)
SITE_URL=https://africanteller.org
DEEP_LINK_BASE_URL=https://africanteller.org

# Sentry (Phase 10) — https://sentry.io
SENTRY_DSN=

# Firebase Cloud Messaging (Phase 4) — service account JSON path
FIREBASE_CREDENTIALS_PATH=

# Luma AI Dream Machine API (Phase 4)
LUMA_API_KEY=
